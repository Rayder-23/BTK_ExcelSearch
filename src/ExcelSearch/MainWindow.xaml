<Window x:Class="ExcelSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExcelSearch"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button x:Name="CountButton" Content="Count Transactions" Padding="16,6" Click="CountButton_Click" />
        <TextBlock x:Name="CountText" Margin="0,12,0,0" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
