<Window x:Class="ExcelSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ExcelSearch.ViewModels"
        xmlns:views="clr-namespace:ExcelSearch.Views"
        mc:Ignorable="d"
        Title="ExcelSearch" Height="820" Width="1240" MinHeight="600" MinWidth="960"
        Icon="pack://application:,,,/ExcelSearch;component/Assets/app.ico"
        Background="{StaticResource PaperBrush}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- A DataTemplate keyed by type: "when the content is an ImportViewModel, draw it with ImportView".
             It is the WPF counterpart of Razor picking a partial/display template from the model's type. -->
        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
            <views:ImportView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:QueryViewModel}">
            <views:QueryView />
        </DataTemplate>

        <!-- Navigation entry: a green bar on the left marks the active screen. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="ToolTip" Value="{Binding DisabledReason}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border x:Name="Bar" Width="4" HorizontalAlignment="Left" Background="Transparent" />
                            <DockPanel Margin="20,13,12,13">
                                <TextBlock x:Name="Soon" Text="SOON" DockPanel.Dock="Right" FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{StaticResource InkMutedBrush}" Opacity="0.7"
                                           Visibility="Collapsed" />
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource InkSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource InkSoftBrush}" />
                                <Setter TargetName="Bar" Property="Background" Value="#35C98A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Soon" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Root" Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Foreground" Value="#5F6C84" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left rail: logo, then navigation. -->
        <Border Grid.Column="0" Background="{StaticResource InkBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,22,12,22" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10" Background="White" Padding="3">
                        <Image Source="pack://application:,,,/ExcelSearch;component/Assets/logo-128.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ExcelSearch" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="White" />
                    </StackPanel>
                </StackPanel>

                <!-- The database in use: a coloured card (blue = SQL Server, green = Local DB) with a large selector. -->
                <Border DockPanel.Dock="Bottom" Margin="12,10,12,14" Padding="12,10,12,12" CornerRadius="0"
                        AutomationProperties.AutomationId="DatabaseCard">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2F5D9E" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocalDb}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GreenBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="DATABASE IN USE" FontSize="10" FontWeight="Bold" Foreground="#CCFFFFFF" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding DatabaseChoices}" SelectedItem="{Binding SelectedDatabase, Mode=TwoWay}"
                                  FontSize="16" FontWeight="SemiBold" Height="38" VerticalContentAlignment="Center"
                                  AutomationProperties.AutomationId="DatabaseSelector"
                                  ToolTip="Choose where imports are stored. Switching restarts the app." />
                        <TextBlock Text="Switching restarts the app." FontSize="10" Foreground="#CCFFFFFF" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Local DB only: a small file button above the database card that opens the folder holding the SQLite file. -->
                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="12,0,12,0" Padding="9,5" Cursor="Hand"
                        Command="{Binding OpenDatabaseFolderCommand}" ToolTip="{Binding DatabaseFilePath}"
                        AutomationProperties.AutomationId="OpenDatabaseFolderButton" AutomationProperties.Name="Open database file location"
                        Background="{StaticResource InkSoftBrush}" Foreground="White" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocalDb}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="File" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource InkSoftBrush}" Margin="0,0,0,10" />

                <!-- Items whose ViewModel is null (none right now) are disabled and cannot be selected. -->
                <ListBox x:Name="NavList" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         AutomationProperties.AutomationId="NavList" />
            </DockPanel>
        </Border>

        <!-- The "content slot": shows whichever screen CurrentViewModel points at. -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
