<UserControl x:Class="ExcelSearch.Views.SummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- One count tile: a colour strip on top, the number in a monospaced face, then a label and a caption.
         Value / Label / Caption / Accent are properties set from XAML, like parameters of a Razor partial. -->
    <Border Style="{StaticResource Card}" MinWidth="150" Margin="0,0,12,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{Binding Accent, ElementName=Root}" CornerRadius="8,8,0,0" />
            <StackPanel Grid.Row="1" Margin="16,6,16,10">
                <TextBlock Text="{Binding Value, ElementName=Root, StringFormat=N0}" FontFamily="{StaticResource MonoFont}"
                           FontSize="26" FontWeight="SemiBold" Foreground="{Binding Accent, ElementName=Root}" />
                <TextBlock Text="{Binding Label, ElementName=Root}" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Caption, ElementName=Root}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
