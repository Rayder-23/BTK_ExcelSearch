<UserControl x:Class="ExcelSearch.Views.SummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" ToolTip="{Binding Caption, ElementName=Root}">
    <!-- One count tile, kept short so the preview grid gets the height: a colour strip on top, the label, then the number in a
         monospaced face. The caption (what happens to these rows) is the tooltip; the tab's hint line says it too.
         Value / Label / Caption / Accent are properties set from XAML, like parameters of a Razor partial. -->
    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{Binding Accent, ElementName=Root}" CornerRadius="8,8,0,0" />
            <StackPanel Grid.Row="1" Margin="12,4,12,6">
                <TextBlock Text="{Binding Label, ElementName=Root}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Value, ElementName=Root, StringFormat=N0}" FontFamily="{StaticResource MonoFont}"
                           FontSize="22" FontWeight="SemiBold" Foreground="{Binding Accent, ElementName=Root}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
