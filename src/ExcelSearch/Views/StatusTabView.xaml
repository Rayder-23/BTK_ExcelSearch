<UserControl x:Class="ExcelSearch.Views.StatusTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- One sentence saying what these rows are; tinted to match the status. -->
        <Border Grid.Row="0" Padding="18,11" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F5F6F1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Conflict">
                            <Setter Property="Background" Value="{StaticResource AmberTintBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Invalid">
                            <Setter Property="Background" Value="{StaticResource RedTintBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="New">
                            <Setter Property="Background" Value="{StaticResource GreenTintBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="13.5" Foreground="{StaticResource TextBrush}"
                       AutomationProperties.AutomationId="TabHint" />
        </Border>

        <Grid Grid.Row="1">
            <!-- Columns are added in code-behind from the ViewModel's Columns list (a header row generated by a loop).
                 Banding comes from the LedgerGrid style (AlternationCount + AlternatingRowBackground). -->
            <DataGrid x:Name="RowsGrid" Style="{StaticResource LedgerGrid}" ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      RowDetailsVisibilityMode="Collapsed"
                      AutomationProperties.AutomationId="RowsGrid">

                <!-- Shown under the selected Conflict row: only the columns that differ, existing value next to file value. -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource AmberTintBrush}" BorderBrush="{StaticResource AmberBrush}"
                                BorderThickness="4,0,0,0" Padding="22,14,22,16" Margin="0,0,0,2">
                            <StackPanel Grid.IsSharedSizeScope="True" MaxWidth="900" HorizontalAlignment="Left">
                                <TextBlock Text="What differs from the row already in the database" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />

                                <!-- Header of the little comparison table -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Existing" MinWidth="220" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Incoming" MinWidth="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Column" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="2" Text="IN DATABASE NOW" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RedBrush}" />
                                    <TextBlock Grid.Column="4" Text="IN THIS FILE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Conflict.Changes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8D9B5" BorderThickness="0,1,0,0" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Existing" />
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Incoming" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ExistingText}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                               Foreground="{StaticResource RedBrush}" TextDecorations="Strikethrough" />
                                                    <TextBlock Grid.Column="3" Text="→" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding IncomingText}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- No single column to point at (or the row vanished): say so in words. -->
                                <TextBlock Text="{Binding Conflict.Summary}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Conflict.ChangeCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <TextBlock Text="No rows in this category." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{StaticResource MutedBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

            <!-- Loading indicator while a page is fetched -->
            <Border Background="#B3FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="220">
                    <TextBlock Text="Loading..." HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}" />
                    <ProgressBar IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,4" Background="#FAFAF7">
            <StackPanel Orientation="Horizontal">
                <Button Content="‹ Previous" Command="{Binding PreviousPageCommand}" Style="{StaticResource PagerButton}" />
                <Button Content="Next ›" Command="{Binding NextPageCommand}" Style="{StaticResource PagerButton}" Margin="6,0,0,0" />
                <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11.5"
                           FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}"
                           AutomationProperties.AutomationId="PageText" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
