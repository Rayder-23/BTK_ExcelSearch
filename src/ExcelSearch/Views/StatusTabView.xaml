<UserControl x:Class="ExcelSearch.Views.StatusTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- The Overwrite checkbox cell. Ticking it saves the choice straight away (the ViewModel does the saving). -->
        <DataTemplate x:Key="OverwriteCell">
            <CheckBox IsChecked="{Binding IsOverwrite, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Cursor="Hand" ToolTip="Replace the database row with this file's values"
                      AutomationProperties.AutomationId="OverwriteCheckBox" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- One sentence saying what these rows are; tinted to match the status. -->
        <Border Grid.Row="0" Padding="14,7" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F5F6F1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Conflict">
                            <Setter Property="Background" Value="{StaticResource AmberTintBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Invalid">
                            <Setter Property="Background" Value="{StaticResource RedTintBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="New">
                            <Setter Property="Background" Value="{StaticResource GreenTintBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
            <!-- Which columns to show (same picker as the Query screen). -->
            <Grid DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0">
                <ToggleButton x:Name="ColumnsToggle" Style="{StaticResource DropdownButton}" Height="30" MinWidth="100"
                              AutomationProperties.AutomationId="ColumnsButton" ToolTip="Choose which columns to show">
                    <TextBlock Text="Columns" FontSize="13" Foreground="{StaticResource TextBrush}" />
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ColumnsToggle}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource Card}" Margin="0,4,12,12" Padding="12,10" MinWidth="190">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.22" Color="#1B2433" />
                        </Border.Effect>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Default" Command="{Binding ResetColumnsCommand}" Style="{StaticResource PagerButton}" Margin="6,0,0,0"
                                        ToolTip="Back to the everyday columns" />
                                <Button DockPanel.Dock="Right" Content="All" Command="{Binding ShowAllColumnsCommand}" Style="{StaticResource PagerButton}"
                                        ToolTip="Show every column" />
                                <TextBlock Text="SHOW COLUMNS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource GreenDarkBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ColumnChoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible, Mode=TwoWay}" Margin="0,4" FontSize="13.5"
                                                      Foreground="{StaticResource TextBrush}" Cursor="Hand" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <StackPanel>
                <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextBrush}"
                           AutomationProperties.AutomationId="TabHint" />

                <!-- Conflict tab only: how many will overwrite (read from the database) and the bulk buttons. -->
                <DockPanel Margin="0,6,0,0" Visibility="{Binding ShowsDetails, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Right" Content="Skip all" Command="{Binding SkipAllCommand}"
                            Style="{StaticResource PagerButton}" Margin="6,0,0,0" AutomationProperties.AutomationId="SkipAllButton" />
                    <Button DockPanel.Dock="Right" Content="Overwrite all" Command="{Binding OverwriteAllCommand}"
                            Style="{StaticResource PagerButton}" AutomationProperties.AutomationId="OverwriteAllButton" />
                    <TextBlock Text="{Binding OverwriteSummary}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" AutomationProperties.AutomationId="OverwriteSummary" />
                </DockPanel>
            </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Columns are added in code-behind from the ViewModel's Columns list (a header row generated by a loop).
                 Banding comes from the LedgerGrid style (AlternationCount + AlternatingRowBackground). -->
            <DataGrid x:Name="RowsGrid" Style="{StaticResource LedgerGrid}" ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      RowDetailsVisibilityMode="Collapsed"
                      AutomationProperties.AutomationId="RowsGrid">

                <!-- Shown under the selected Conflict row: only the columns that differ, existing value next to file value. -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource AmberTintBrush}" BorderBrush="{StaticResource AmberBrush}"
                                BorderThickness="4,0,0,0" Padding="22,14,22,16" Margin="0,0,0,2">
                            <StackPanel Grid.IsSharedSizeScope="True" MaxWidth="900" HorizontalAlignment="Left">
                                <TextBlock Text="What differs from the row already in the database" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />

                                <!-- Header of the little comparison table -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Existing" MinWidth="220" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Incoming" MinWidth="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Column" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="2" Text="IN DATABASE NOW" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RedBrush}" />
                                    <TextBlock Grid.Column="4" Text="IN THIS FILE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Conflict.Changes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8D9B5" BorderThickness="0,1,0,0" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Existing" />
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Incoming" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ExistingText}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                               Foreground="{StaticResource RedBrush}" TextDecorations="Strikethrough" />
                                                    <TextBlock Grid.Column="3" Text="→" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding IncomingText}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- No single column to point at (or the row vanished): say so in words. -->
                                <TextBlock Text="{Binding Conflict.Summary}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Conflict.ChangeCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <TextBlock Text="No rows in this category." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{StaticResource MutedBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

            <!-- Loading indicator while a page is fetched -->
            <Border Background="#B3FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="220">
                    <TextBlock Text="Loading..." HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}" />
                    <ProgressBar IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
