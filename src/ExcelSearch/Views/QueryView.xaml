<UserControl x:Class="ExcelSearch.Views.QueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ExcelSearch.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:OffsetConverter x:Key="Offset" />

        <!-- Cells keep the row height themselves: otherwise a row whose details are open gets its 30 px minimum from the details
             and the row's own text line is squeezed. -->
        <Style x:Key="QueryCell" TargetType="DataGridCell" BasedOn="{StaticResource LedgerCell}">
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <!-- Every filter in the drawer is full width with a little space below it. -->
        <Style x:Key="FilterRow" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- One chip in the "what is filtered" strip: the text and a small x that removes that filter. -->
        <DataTemplate x:Key="ChipTemplate">
            <Border Background="{StaticResource GreenTintBrush}" BorderBrush="#BFDCCB" BorderThickness="1" CornerRadius="13"
                    Margin="0,0,6,4" Padding="11,3,3,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource GreenDarkBrush}"
                               FontWeight="SemiBold" MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                    <Button Content="&#x2715;" FontSize="10" Width="20" Height="20" Margin="4,0,0,0" Style="{StaticResource BannerCloseButton}"
                            Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="Remove this filter" AutomationProperties.Name="Remove filter" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A "min - max" amount pair is a Grid of two boxes; these keep the three of them identical. -->
        <Style x:Key="TotalLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="TotalValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </UserControl.Resources>

    <!-- DataContext is the QueryViewModel (set by the DataTemplate in MainWindow).
         Layout: a toolbar, the active-filter chips, then [filter drawer | results] and one slim bottom bar. The drawer folds
         away (by default right after a search) so the results get the whole width and height. -->
    <Grid Margin="20,14,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- toolbar -->
            <RowDefinition Height="Auto" />   <!-- banner -->
            <RowDefinition Height="Auto" />   <!-- chips -->
            <RowDefinition Height="*" />      <!-- drawer + results -->
            <RowDefinition Height="Auto" />   <!-- totals + pager -->
        </Grid.RowDefinitions>

        <!-- ===== Toolbar ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ExportHint}" FontSize="12" Foreground="{StaticResource AmberBrush}" MaxWidth="300" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" TextAlignment="Right" AutomationProperties.AutomationId="ExportHint" />

                <!-- Which columns to show -->
                <Grid Margin="0,0,8,0">
                    <ToggleButton x:Name="ColumnsToggle" Style="{StaticResource DropdownButton}" Height="34" MinWidth="104"
                                  AutomationProperties.AutomationId="ColumnsButton" ToolTip="Choose which columns to show">
                        <TextBlock Text="Columns" FontSize="13.5" Foreground="{StaticResource TextBrush}" />
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ColumnsToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource Card}" Margin="0,4,12,12" Padding="12,10" MinWidth="190">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.22" Color="#1B2433" />
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Default" Command="{Binding ResetColumnsCommand}" Style="{StaticResource PagerButton}" Margin="6,0,0,0"
                                            ToolTip="Back to the everyday columns" />
                                    <Button DockPanel.Dock="Right" Content="All" Command="{Binding ShowAllColumnsCommand}" Style="{StaticResource PagerButton}"
                                            ToolTip="Show every column" />
                                    <TextBlock Text="SHOW COLUMNS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource GreenDarkBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ColumnChoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible, Mode=TwoWay}" Margin="0,4" FontSize="13.5"
                                                      Foreground="{StaticResource TextBrush}" Cursor="Hand" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- What an export writes: the ticked columns (default) or everything. -->
                <ComboBox ItemsSource="{x:Static views:QueryView.ExportScopes}" SelectedItem="{Binding ExportScope, Mode=TwoWay}" Width="142" Height="34"
                          VerticalContentAlignment="Center" Margin="0,0,8,0" FontSize="13" ToolTip="What Export results writes"
                          AutomationProperties.AutomationId="ExportScopeBox" />

                <!-- Export: a button, or its progress with Cancel while it runs. -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ExportProgressText}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12.5"
                               FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" AutomationProperties.AutomationId="ExportProgress" />
                    <Button Content="Cancel" Command="{Binding ExportCancelCommand}" Style="{StaticResource SecondaryButton}" Padding="16,7"
                            AutomationProperties.AutomationId="ExportCancelButton" />
                </StackPanel>
                <Button Content="Export results" Command="{Binding ExportCommand}" Padding="20,7" AutomationProperties.AutomationId="ExportButton">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Search" Style="{StaticResource SubHeading}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Button Command="{Binding ToggleFilterPanelCommand}" Style="{StaticResource PrimaryButton}" Padding="16,7"
                        AutomationProperties.AutomationId="FiltersToggleButton" ToolTip="Show or hide the filters">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M0,0 L11,0 L7,5 L7,11 L4,9 L4,5 Z" Fill="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding FiltersButtonText}" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Banner: timeouts, database errors, export result. Stays until the user closes it. -->
        <Border Grid.Row="1" Background="{StaticResource AmberTintBrush}" BorderBrush="{StaticResource AmberBrush}"
                BorderThickness="4,0,0,0" CornerRadius="4" Padding="16,10" Margin="0,0,0,10"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="QueryMessageBanner">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#x2715;" Command="{Binding DismissMessageCommand}" Style="{StaticResource BannerCloseButton}"
                        VerticalAlignment="Top" Margin="12,-2,-6,0" ToolTip="Dismiss" AutomationProperties.Name="Dismiss message"
                        AutomationProperties.AutomationId="QueryDismissMessageButton" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextBrush}" LineHeight="21" />
            </DockPanel>
        </Border>

        <!-- ===== What is filtered right now (each chip removes one filter and searches again) ===== -->
        <DockPanel Grid.Row="2" Margin="0,0,0,6" Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"
                   AutomationProperties.AutomationId="FilterChips">
            <Button DockPanel.Dock="Right" Content="Clear all" Command="{Binding ClearCommand}" Style="{StaticResource PagerButton}"
                    VerticalAlignment="Top" Margin="8,0,0,4" />
            <ItemsControl ItemsSource="{Binding ActiveFilters}" ItemTemplate="{StaticResource ChipTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>

        <!-- ===== Filter drawer + results ===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Filter drawer: full-width inputs in a scrolling column, Search and Clear always visible at the bottom. -->
            <Border x:Name="FilterPanel" Grid.Column="0" Style="{StaticResource Card}" Width="320" Margin="0,0,12,0"
                    Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="FilterDrawer">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12" Background="#FAFAF7"
                            CornerRadius="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="{Binding FilterError}" Foreground="{StaticResource RedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding HasFilterError, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="FilterError" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Padding="0,9"
                                        AutomationProperties.AutomationId="SearchButton" />
                                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButton}" Padding="18,9"
                                        Margin="8,0,0,0" AutomationProperties.AutomationId="ClearButton" />
                            </Grid>
                            <CheckBox Content="Hide filters after searching" IsChecked="{Binding AutoHideFilters, Mode=TwoWay}" FontSize="12.5" Margin="0,10,0,0"
                                      Foreground="{StaticResource MutedBrush}" Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                        </ScrollViewer.Resources>
                        <StackPanel Margin="16,14,16,4">
                            <!-- The common filters -->
                            <Grid Style="{StaticResource FilterRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Value date from" Style="{StaticResource FilterLabel}" />
                                    <DatePicker SelectedDate="{Binding ValueDateFrom, Mode=TwoWay}" Style="{StaticResource FilterDatePicker}" AutomationProperties.AutomationId="DateFrom" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Value date to" Style="{StaticResource FilterLabel}" />
                                    <DatePicker SelectedDate="{Binding ValueDateTo, Mode=TwoWay}" Style="{StaticResource FilterDatePicker}" AutomationProperties.AutomationId="DateTo" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Style="{StaticResource FilterRow}">
                                <DockPanel Margin="1,0,0,4">
                                    <ToggleButton DockPanel.Dock="Right" Content="starts with" IsChecked="{Binding CustomerNameStartsWith, Mode=TwoWay}" Style="{StaticResource ModeToggle}"
                                                  ToolTip="Off: the name contains what you typed. On: the name starts with it (faster on SQL Server)."
                                                  AutomationProperties.AutomationId="CustomerNameStartsWith" />
                                    <TextBlock Text="Customer name" Style="{StaticResource FilterLabel}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBox Style="{StaticResource FilterTextBox}" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CustomerName" />
                            </StackPanel>

                            <views:TextFilterBox DataContext="{Binding Cnic}" Style="{StaticResource FilterRow}" AutomationProperties.AutomationId="Cnic" />
                            <views:TextFilterBox DataContext="{Binding ApplicationNo}" Style="{StaticResource FilterRow}" AutomationProperties.AutomationId="ApplicationNo" />
                            <views:TextFilterBox DataContext="{Binding PayOrderNo}" Style="{StaticResource FilterRow}" AutomationProperties.AutomationId="PayOrderNo" />
                            <views:TextFilterBox DataContext="{Binding TxnRefSeqNo}" Style="{StaticResource FilterRow}" AutomationProperties.AutomationId="TxnRefSeqNo" />
                            <views:TextFilterBox DataContext="{Binding SlipNo}" Style="{StaticResource FilterRow}" AutomationProperties.AutomationId="SlipNo" />

                            <Expander Style="{StaticResource MoreFilters}" AutomationProperties.AutomationId="MoreFilters" Margin="0,0,0,10">
                                <StackPanel>
                                    <views:MultiSelectBox DataContext="{Binding Banks}" Style="{StaticResource FilterRow}" />
                                    <views:MultiSelectBox DataContext="{Binding Projects}" Style="{StaticResource FilterRow}" />
                                    <views:MultiSelectBox DataContext="{Binding Dealers}" Style="{StaticResource FilterRow}" />
                                    <views:MultiSelectBox DataContext="{Binding Branches}" Style="{StaticResource FilterRow}" />
                                    <views:MultiSelectBox DataContext="{Binding DataSources}" Style="{StaticResource FilterRow}" />

                                    <views:TextFilterBox DataContext="{Binding RegNo}" Style="{StaticResource FilterRow}" />
                                    <views:TextFilterBox DataContext="{Binding ChallanNo}" Style="{StaticResource FilterRow}" />
                                    <views:TextFilterBox DataContext="{Binding ChequeInstNo}" Style="{StaticResource FilterRow}" />
                                    <views:TextFilterBox DataContext="{Binding AccountNo}" Style="{StaticResource FilterRow}" />

                                    <StackPanel Style="{StaticResource FilterRow}">
                                        <TextBlock Text="Credit between" Style="{StaticResource FilterLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource FilterTextBox}" Text="{Binding CreditMin, UpdateSourceTrigger=PropertyChanged}" ToolTip="Minimum credit" AutomationProperties.AutomationId="CreditMin" />
                                            <TextBlock Grid.Column="1" Text="–" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox Grid.Column="2" Style="{StaticResource FilterTextBox}" Text="{Binding CreditMax, UpdateSourceTrigger=PropertyChanged}" ToolTip="Maximum credit" AutomationProperties.AutomationId="CreditMax" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FilterRow}">
                                        <TextBlock Text="Debit between" Style="{StaticResource FilterLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource FilterTextBox}" Text="{Binding DebitMin, UpdateSourceTrigger=PropertyChanged}" ToolTip="Minimum debit" AutomationProperties.AutomationId="DebitMin" />
                                            <TextBlock Grid.Column="1" Text="–" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox Grid.Column="2" Style="{StaticResource FilterTextBox}" Text="{Binding DebitMax, UpdateSourceTrigger=PropertyChanged}" ToolTip="Maximum debit" AutomationProperties.AutomationId="DebitMax" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FilterRow}">
                                        <TextBlock Text="Down payment between" Style="{StaticResource FilterLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource FilterTextBox}" Text="{Binding DownPaymentMin, UpdateSourceTrigger=PropertyChanged}" ToolTip="Minimum down payment" AutomationProperties.AutomationId="DownPaymentMin" />
                                            <TextBlock Grid.Column="1" Text="–" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox Grid.Column="2" Style="{StaticResource FilterTextBox}" Text="{Binding DownPaymentMax, UpdateSourceTrigger=PropertyChanged}" ToolTip="Maximum down payment" AutomationProperties.AutomationId="DownPaymentMax" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FilterRow}">
                                        <TextBlock Text="Import batch no" Style="{StaticResource FilterLabel}" />
                                        <TextBox Style="{StaticResource FilterTextBox}" Text="{Binding ImportBatchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Only rows that came from this import (the batch number is shown in the row details)" AutomationProperties.AutomationId="ImportBatch" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Results ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <!-- Columns are added in code-behind from the ViewModel's Columns list. Header clicks sort on the server.
                         The first two columns stay put while scrolling sideways; the selected row opens its details underneath. -->
                    <DataGrid x:Name="ResultsGrid" Style="{StaticResource LedgerGrid}" ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}" ColumnHeaderStyle="{StaticResource QueryColumnHeader}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserReorderColumns="True" SelectionMode="Single" SelectionUnit="FullRow"
                              FrozenColumnCount="2" FontSize="13" CellStyle="{StaticResource QueryCell}"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              RowDetailsVisibilityMode="VisibleWhenSelected" AreRowDetailsFrozen="True"
                              AutomationProperties.AutomationId="ResultsGrid">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource LedgerRow}">
                                <Setter Property="MinHeight" Value="30" />
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- The details of the selected row: every field in groups laid out side by side, then where it was imported from. -->
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <!-- Exactly as wide as the visible grid (not as wide as all the columns), so the groups wrap instead of running off to the right. -->
                                <Border Background="#F7F8F3" BorderBrush="{StaticResource GreenBrush}" BorderThickness="4,0,0,0" Padding="20,12,16,14" Margin="0,0,0,2"
                                        HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=ResultsGrid, Converter={StaticResource Offset}, ConverterParameter=26}"
                                        AutomationProperties.AutomationId="DetailsPanel">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="&#x2715;" Style="{StaticResource BannerCloseButton}" ToolTip="Close details"
                                                    Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    AutomationProperties.Name="Close details" />
                                            <TextBlock Text="Transaction details" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding DataContext.DetailSections, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="270" Margin="0,8,22,6">
                                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenDarkBrush}" Margin="0,0,0,4" />
                                                        <ItemsControl ItemsSource="{Binding Fields}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="104" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsMono}" Value="True">
                                                                                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                                                            <Setter Property="FontSize" Value="12.5" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>

                    <!-- Before the first search -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                                Visibility="{Binding ShowPrompt, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Set your filters and press Search" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Style="{StaticResource Body}" TextAlignment="Center" Margin="0,8,0,0"
                                   Text="Pressing Search with nothing filled in shows the most recent transactions." />
                    </StackPanel>

                    <!-- No rows matched -->
                    <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420" FontSize="14.5" Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding IsEmptyResult, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="EmptyText" />

                    <!-- Busy indicator while the page loads; the search can be cancelled from here. -->
                    <Border Background="#B3FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="BusyIndicator">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="240">
                            <TextBlock Text="Searching…" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}" />
                            <ProgressBar IsIndeterminate="True" />
                            <Button Content="Cancel" Command="{Binding CancelSearchCommand}" Style="{StaticResource PagerButton}"
                                    HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== One slim bottom bar. Left: the totals for the WHOLE filtered set on one line, with the result count
                   (green) at its right end. Right of that: paging. The totals fill in after the rows. ===== -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource InkBrush}" CornerRadius="6" Padding="14,0" Height="30" Margin="0,0,12,0"
                    Visibility="{Binding HasSearched, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.AutomationId="TotalsStrip">
                <DockPanel>
                    <!-- The count stays at the right end of the bar, in green so it is noticed. -->
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold"
                               Foreground="#35C98A" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.AutomationId="TotalText" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Credit" Style="{StaticResource TotalLabel}" />
                    <TextBlock Text="{Binding CreditTotalText}" Style="{StaticResource TotalValue}" AutomationProperties.AutomationId="CreditTotal" />
                    <TextBlock Text="Debit" Style="{StaticResource TotalLabel}" />
                    <TextBlock Text="{Binding DebitTotalText}" Style="{StaticResource TotalValue}" AutomationProperties.AutomationId="DebitTotal" />
                    <TextBlock Text="Down payment" Style="{StaticResource TotalLabel}" />
                    <TextBlock Text="{Binding DownPaymentTotalText}" Style="{StaticResource TotalValue}" Margin="0" AutomationProperties.AutomationId="DownPaymentTotal" />
                </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="‹ Prev" Command="{Binding PreviousPageCommand}" Style="{StaticResource PagerButton}" ToolTip="Previous page" AutomationProperties.AutomationId="PreviousPageButton" />
                <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="8,0" FontSize="12" FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource MutedBrush}" AutomationProperties.AutomationId="PageText" />
                <Button Content="Next ›" Command="{Binding NextPageCommand}" Style="{StaticResource PagerButton}" ToolTip="Next page" AutomationProperties.AutomationId="NextPageButton" />
                                <ComboBox ItemsSource="{x:Static views:QueryView.PageSizes}" SelectedItem="{Binding SelectedPageSize, Mode=TwoWay}" Width="60" Margin="10,0,0,0"
                          FontSize="12" VerticalContentAlignment="Center" ToolTip="Rows per page" AutomationProperties.AutomationId="PageSizeBox" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
