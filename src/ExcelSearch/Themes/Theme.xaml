<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        "Ledger" look: ink-navy chrome, warm ledger-paper background, the logo's Excel green as the one accent,
        amber for conflicts and brick red for errors. Numbers and keys use a monospaced face so digits line up.
        This file is the WPF counterpart of a site-wide CSS file: named brushes + styles that views refer to
        with {StaticResource Name}.
    -->

    <!-- ===== Palette ===== -->
    <SolidColorBrush x:Key="InkBrush" Color="#1B2433" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="#2B374D" />
    <SolidColorBrush x:Key="InkTextBrush" Color="#E8EDF5" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="#8E9AB0" />
    <SolidColorBrush x:Key="PaperBrush" Color="#F3F2EC" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#DAD8CE" />
    <SolidColorBrush x:Key="TextBrush" Color="#1E2430" />
    <SolidColorBrush x:Key="MutedBrush" Color="#677085" />
    <SolidColorBrush x:Key="GreenBrush" Color="#1F8A5B" />
    <SolidColorBrush x:Key="GreenDarkBrush" Color="#166B46" />
    <SolidColorBrush x:Key="GreenTintBrush" Color="#E5F2EA" />
    <SolidColorBrush x:Key="AmberBrush" Color="#B7791F" />
    <SolidColorBrush x:Key="AmberTintBrush" Color="#FBF1DC" />
    <SolidColorBrush x:Key="RedBrush" Color="#B3392F" />
    <SolidColorBrush x:Key="RedTintBrush" Color="#FBE9E6" />
    <SolidColorBrush x:Key="SlateBrush" Color="#5B6B85" />
    <SolidColorBrush x:Key="BandBrush" Color="#DCE7DF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#CBE1D3" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#B4D9C4" />

    <!-- ===== Type ===== -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="SubHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource GreenBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GreenDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#10583A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Red button: used for the Invalid tab's export, so it is hard to miss when it appears. -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource RedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#8F2B23" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#701F19" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small flat "x" for closing a banner. -->
    <Style x:Key="BannerCloseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A000000" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small button used for Previous / Next -->
    <Style x:Key="PagerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===== Progress bar ===== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
        <Setter Property="Background" Value="#DDE5DF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="8" />
    </Style>

    <!-- ===== Tabs: a quiet underline for the selected one ===== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Background="Transparent" />
                        </Border>
                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Padding="0">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Padding="16,10" Margin="0,0,2,-1" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0,0,0,3">
                        <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8EEE9" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Thin scroll bars: 10 px instead of the system default (about 17 px) ===== -->
    <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="#B3BCB6" CornerRadius="4" Margin="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#8E9A93" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#6F7D75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="#F0F1EC" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollTrackButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollTrackButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10" />
                <Setter Property="MinWidth" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Data grid: banded rows, ink header, monospaced numbers ===== -->
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style x:Key="CellMono" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style x:Key="CellNumber" TargetType="TextBlock" BasedOn="{StaticResource CellMono}">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="CellError" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="Margin" Value="0,6" />
    </Style>

    <!-- Column header with a sort hint: a faint up/down marker on every column says "click to sort";
         the active column lights up the arrow for its direction. Sorting is done on the rows of the current page. -->
    <Style x:Key="HeaderGripper" TargetType="Thumb">
        <Setter Property="Width" Value="6" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LedgerColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="#3A4862" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Click to sort all the rows of this tab" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <!-- Two small triangles: up and down. Both faint until a sort is active. -->
                                <Grid x:Name="SortMarker" DockPanel.Dock="Right" Width="8" Height="12" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Path x:Name="UpTri" Data="M0,5 L4,0 L8,5 Z" Fill="#9FB0CC" Opacity="0.4" VerticalAlignment="Top" />
                                    <Path x:Name="DownTri" Data="M0,0 L8,0 L4,5 Z" Fill="#9FB0CC" Opacity="0.4" VerticalAlignment="Bottom" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </DockPanel>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource HeaderGripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource HeaderGripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#394863" />
                            <Setter TargetName="UpTri" Property="Opacity" Value="0.85" />
                            <Setter TargetName="DownTri" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="UpTri" Property="Fill" Value="#35C98A" />
                            <Setter TargetName="UpTri" Property="Opacity" Value="1" />
                            <Setter TargetName="DownTri" Property="Opacity" Value="0.15" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="DownTri" Property="Fill" Value="#35C98A" />
                            <Setter TargetName="DownTri" Property="Opacity" Value="1" />
                            <Setter TargetName="UpTri" Property="Opacity" Value="0.15" />
                        </Trigger>
                        <!-- A column that cannot be sorted (see UnsortableColumnHeader): no marker, no hand cursor. -->
                        <Trigger Property="Tag" Value="NoSort">
                            <Setter TargetName="SortMarker" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="ToolTip" Value="{x:Null}" />
                        </Trigger>
                        <!-- The empty filler header at the far right is not a column: no marker, no hand cursor. -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="SortMarker" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="ToolTip" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LedgerCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LedgerRow" TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- AlternationCount="2" is what actually switches banding on; without it AlternatingRowBackground does nothing. -->
    <Style x:Key="LedgerGrid" TargetType="DataGrid">
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource BandBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource LedgerColumnHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource LedgerCell}" />
        <Setter Property="RowStyle" Value="{StaticResource LedgerRow}" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Style.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
        </Style.Resources>
    </Style>

    <Style x:Key="DoneValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="24,4,0,4" />
    </Style>

    <!-- Plain white panel with a hairline border: the base of every card. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- ===== Query screen: filter inputs ===== -->
    <Style x:Key="FilterLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Margin" Value="1,0,0,4" />
    </Style>

    <!-- Rounded text box with a green outline while it has the keyboard focus. -->
    <Style x:Key="FilterTextBox" TargetType="TextBox">
        <!-- Grows (up to about four lines) and wraps instead of hiding the end of a long value; hovering shows the whole text. -->
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MaxHeight" Value="96" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SelectionBrush" Value="{StaticResource SelectedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#B9B7A9" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="ToolTipService.IsEnabled" Value="False" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterDatePicker" TargetType="DatePicker">
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- The little "exact" switch inside a text filter: off = starts with (default), on = whole value. -->
    <Style x:Key="ModeToggle" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="#EEEDE6" CornerRadius="4" Padding="6,2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E0DFD5" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GreenBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Closed multi-select dropdown: looks like a filter box with a caret. -->
    <Style x:Key="DropdownButton" TargetType="ToggleButton">
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="9,0,8,0" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Path DockPanel.Dock="Right" Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#B9B7A9" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "More filters" expander: a text link with a turning caret instead of the stock arrow. -->
    <Style x:Key="MoreFilters" TargetType="Expander">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Focusable="False" Cursor="Hand" HorizontalAlignment="Left">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0,2">
                                        <Path x:Name="Caret" Data="M0,0 L5,4 L0,8 Z" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                        <TextBlock x:Name="Label" Text="More filters" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="13.5"
                                                   Foreground="{StaticResource GreenBrush}" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Caret" Property="RenderTransform">
                                                <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                            </Setter>
                                            <Setter TargetName="Label" Property="Text" Value="Fewer filters" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Content" Visibility="Collapsed" Margin="0,10,0,0" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Content" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header of a column that has no server-side sort (e.g. the result of comparing with the database). -->
    <Style x:Key="UnsortableColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LedgerColumnHeader}">
        <Setter Property="Tag" Value="NoSort" />
    </Style>

    <!-- Sort hint on the Query grid: the sort runs on the server over the whole result, not just the visible page. -->
    <Style x:Key="QueryColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LedgerColumnHeader}">
        <Setter Property="ToolTip" Value="Click to sort the whole result" />
    </Style>
</ResourceDictionary>
